package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test_helper_app {
    name: "FrankensteinBrokerReachabilityProbe",
    manifest: "broker/AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    test_suites: ["device-tests"],
}

android_test_helper_app {
    name: "FrankensteinOrdinaryReachabilityProbe",
    manifest: "ordinary/AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    certificate: "testkey",
    privileged: false,
    platform_apis: false,
    sdk_version: "current",
    test_suites: ["device-tests"],
}
